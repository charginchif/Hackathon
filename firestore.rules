rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ESCUELAS SEGURAS - SECURITY RULES CONFIGURATION
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a Database Access Control (DBAC) model focused on Authorization Independence.
     * Access is determined primarily by the existence of authorization tokens in dedicated shadow 
     * collections (/globalAdmins and /schoolStudents).
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/globalAdmins/$(request.auth.uid));
    }

    function isStudentOfSchool(schoolId) {
      return isSignedIn() && exists(/databases/$(database)/documents/schoolStudents/$(schoolId)/students/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isGlobalAdmin();
      allow list: if isGlobalAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) && request.resource.data.id == resource.data.id) || isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

    match /globalAdmins/{globalAdminId} {
      // Prototype mode: Allow self-registration for admins
      allow read: if isGlobalAdmin();
      allow write: if isGlobalAdmin() || isOwner(globalAdminId);
    }

    match /schoolStudents/{schoolId}/students/{studentId} {
      allow get: if isOwner(studentId) || isGlobalAdmin();
      allow list: if isGlobalAdmin() || (isSignedIn() && request.query.limit <= 100);
      // Prototype mode: Allow students to register their own school mapping
      allow write: if isGlobalAdmin() || isOwner(studentId);
    }

    match /schools/{schoolId} {
      allow get: if isGlobalAdmin() || isStudentOfSchool(schoolId);
      allow list: if isGlobalAdmin();
      allow write: if isGlobalAdmin();

      match /incidents/{incidentId} {
        allow get, list: if isGlobalAdmin() || isStudentOfSchool(schoolId);
        
        allow create: if (isGlobalAdmin() || isStudentOfSchool(schoolId)) 
                      && request.resource.data.schoolId == schoolId
                      && request.resource.data.reporterUserId == request.auth.uid;
        
        allow update: if isGlobalAdmin() 
                      || (isExistingOwner(resource.data.reporterUserId) 
                          && request.resource.data.reporterUserId == resource.data.reporterUserId
                          && request.resource.data.schoolId == resource.data.schoolId);
        
        allow delete: if isGlobalAdmin();
      }

      match /accessLogs/{accessLogId} {
        allow read, write: if isGlobalAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}