
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario institucional ISSU.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["alumno", "autoridad"] },
        "campus": { "type": "string" },
        "roleDisplay": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "role", "campus"]
    },
    "Incident": {
      "title": "Incident",
      "type": "object",
      "description": "Reporte de incidencia o alerta SOS.",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string", "enum": ["Infraestructura", "Sospechoso", "Emergencia", "Acoso", "SOS"] },
        "description": { "type": "string" },
        "zone": { "type": "string" },
        "campus": { "type": "string" },
        "status": { "type": "string", "enum": ["pendiente", "atendido", "despachado"] },
        "severity": { "type": "string", "enum": ["baja", "media", "alta", "critica"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "coords": {
          "type": "object",
          "properties": {
            "top": { "type": "string" },
            "left": { "type": "string" }
          }
        }
      },
      "required": ["category", "description", "campus", "status", "userId", "userName", "timestamp"]
    },
    "AccessLog": {
      "title": "AccessLog",
      "type": "object",
      "description": "Registro de entrada o salida perimetral.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "campus": { "type": "string" },
        "gate": { "type": "string" },
        "type": { "type": "string", "enum": ["Entrada", "Salida"] },
        "status": { "type": "string", "enum": ["Autorizado", "Denegado"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "campus", "type", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Perfiles de alumnos y personal ISSU."
    },
    "/schools/{schoolId}/incidents/{incidentId}": {
      "schema": { "$ref": "#/backend/entities/Incident" },
      "description": "Incidentes y alertas SOS por plantel."
    },
    "/schools/{schoolId}/accessLogs/{logId}": {
      "schema": { "$ref": "#/backend/entities/AccessLog" },
      "description": "Bitácora de flujos por plantel."
    }
  }
}
